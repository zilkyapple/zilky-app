# Puerto donde corre el servidor (Render lo define solo; para tu compu dejalo en 3000)
PORT=3000

# String de conexión a Postgres (el que te da Neon en producción).
DATABASE_URL=postgresql://usuario:password@host:5432/basededatos

# Cualquier texto largo y secreto (firma las sesiones). Generá el tuyo con:
# node -e "console.log(require('crypto').randomUUID())"
JWT_SECRET=cambiar-esto-por-un-texto-largo-y-secreto
